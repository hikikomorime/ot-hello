# Maintainer-only FTP credentials for plugins.onethird.pl
# Same account as OT re:Writer / ot-seo — never commit the filled file.
#
# Preferred: leave this file empty and keep rewriter credentials in the sibling:
#   C:\Users\micha\OneDrive\Dokumenty\AI-Projects\OneThird\ai-rewriter\scripts\.env
# deploy-update reads that path automatically. Optional local copy:
#   cp ../ai-rewriter/scripts/.env scripts/.env
# Then set OT_PLUGINS_FTP_REMOTE_DIR=ot-hello (do not reuse ot-rewriter).

OT_PLUGINS_FTP_HOST=plugins.onethird.pl
OT_PLUGINS_FTP_USER=
OT_PLUGINS_FTP_PASS=
OT_PLUGINS_FTP_REMOTE_DIR=ot-hello
