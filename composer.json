{
  "name": "onethird/ot-hello",
  "description": "OT Hello — modern OneThird WordPress plugin template with a Fluent admin SPA.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Michael Skweres | OneThird",
      "homepage": "https://onethird.pl"
    }
  ],
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "OTHello\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "OTHello\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
