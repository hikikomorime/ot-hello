# Plugin artifacts are tracked on purpose — do not ignore:
#   backups/*.zip, build/, composer.lock, package-lock.json, languages/*.mo
#
# Only exclude secrets, installable dependencies, and local caches.

# Dependencies (regenerate with npm install / composer install)
node_modules/
vendor/

# Local secrets — never commit
scripts/.env
.env
.env.local

# Tooling caches
.phpunit.cache/
.phpunit.result.cache
*.log
.DS_Store

# Local zip staging (the installable ZIP lives in backups/)
dist/

# Editor
.idea/
.vscode/
*.swp
